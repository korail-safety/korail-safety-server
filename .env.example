# 복사해서 .env 로 사용하세요: cp .env.example .env

APP_ENV=local

# docker-compose.yml 의 PostgreSQL과 맞춤
DATABASE_URL=postgresql+psycopg://korail:korail@localhost:5432/korail_safety

# CORS 허용 프론트 주소 (JSON 배열)
FRONTEND_ORIGINS=["http://localhost:3000"]

# 회원가입 공용 관리자 코드
ADMIN_SIGNUP_CODE=change-me

# 로그인 토큰 서명 키 (배포 때는 긴 랜덤 문자열: openssl rand -hex 32)
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 파일 저장소 (AWS S3) — 실제 키는 .env 에만
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=korail-safety-dev-saframe
PRESIGNED_URL_EXPIRE_SECONDS=3600

# 보고서 업로드 최대 크기(MB)
MAX_REPORT_SIZE_MB=20

# OPENAI_API_KEY
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
